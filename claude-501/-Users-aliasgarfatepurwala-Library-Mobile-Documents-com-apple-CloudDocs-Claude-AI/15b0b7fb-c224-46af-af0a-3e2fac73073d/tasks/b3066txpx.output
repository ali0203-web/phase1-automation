umFractionDigits: 2 }) || '427,893.45'}\n+                </span>\n+                <span className=\"buying-power\">\n+                  Buying Power: ${balance?.buying_power?.toLocaleString('en-US', { minimumFractionDigits: 2 }) || '856,234.12'}\n+                </span>\n+                <span className={`portfolio-gain ${(balance?.daily_pnl || 0) >= 0 ? 'positive' : 'negative'}`}>\n+                  Portfolio ${balance?.daily_pnl >= 0 ? '+' : ''}${balance?.daily_pnl?.toLocaleString('en-US', { minimumFractionDigits: 2 }) || '+$34,567.89'} \n+                  ({balance?.daily_pnl_percent?.toFixed(2) || '+8.76'}%)\n+                </span>\n+              </>\n+            )}\n+            {error && <span style={{color: '#ef4444'}}>Error: {error}</span>}\n           </div>\n         </div>\n       </header>\n@@ -70,18 +88,24 @@ export default function Dashboard() {\n           </div>\n \n           <div className=\"sidebar-section\">\n-            <h3>Watchlist</h3>\n-            <div className=\"watchlist-items\">\n-              {watchlist.map(item => (\n-                <div key={item.symbol} className=\"watchlist-item\">\n-                  <div className=\"watchlist-symbol\">{item.image} {item.symbol}</div>\n-                  <div className=\"watchlist-price\">${item.price.toLocaleString('en-US', { minimumFractionDigits: 2 })}</div>\n-                  <div className={`watchlist-change ${item.change > 0 ? 'positive' : 'negative'}`}>\n-                    {item.change > 0 ? '+' : ''}{item.change.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n+            <h3>Your Positions ({positions.length})</h3>\n+            {isLoading ? (\n+              <p>Loading positions...</p>\n+            ) : positions.length > 0 ? (\n+              <div className=\"watchlist-items\">\n+                {positions.map(pos => (\n+                  <div key={pos.symbol} className=\"watchlist-item\">\n+                    <div className=\"watchlist-symbol\">📊 {pos.symbol}</div>\n+                    <div className=\"watchlist-price\">${pos.current_price?.toLocaleString('en-US', { minimumFractionDigits: 2 })}</div>\n+                    <div className={`watchlist-change ${pos.unrealized_pnl >= 0 ? 'positive' : 'negative'}`}>\n+                      {pos.unrealized_pnl > 0 ? '+' : ''}${pos.unrealized_pnl.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n+                    </div>\n                   </div>\n-                </div>\n-              ))}\n-            </div>\n+                ))}\n+              </div>\n+            ) : (\n+              <p>No open positions</p>\n+            )}\n           </div>\n \n           <div className=\"sidebar-section\">\n@@ -97,11 +121,6 @@ export default function Dashboard() {\n                 <span className=\"event\">Fed Minutes</span>\n                 <span className=\"impact\">🟡 Medium</span>\n               </div>\n-              <div className=\"calendar-item low-impact\">\n-                <span className=\"time\">09:45 EDT</span>\n-                <span className=\"event\">Markit PMI</span>\n-                <span className=\"impact\">🟢 Low</span>\n-              </div>\n             </div>\n           </div>\n         </aside>\n@@ -112,13 +131,15 @@ export default function Dashboard() {\n           <section className=\"chart-section\">\n             <div className=\"chart-header\">\n               <div className=\"chart-info\">\n-                <h2>AAPL - Apple Inc.</h2>\n+                <h2>{demoData.symbol} - {demoData.name}</h2>\n                 <div className=\"chart-details\">\n-                  <span className=\"price\">$227.45</span>\n-                  <span className=\"change positive\">+$5.67 (+2.55%)</span>\n-                  <span className=\"volume\">Vol: 52.3M</span>\n-                  <span className=\"high\">H: $230.12</span>\n-                  <span className=\"low\">L: $225.98</span>\n+                  <span className=\"price\">${demoData.price}</span>\